{
  "manifest_version": 3,
  "name": "SONICOD – Bot Retours WhatsApp",
  "version": "1.0.0",
  "description": "Lit les étiquettes « BON RETOUR » des groupes WhatsApp Web et enregistre les colis du jour dans « Retours en attente ».",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
